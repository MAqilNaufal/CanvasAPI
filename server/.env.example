# Port the API listens on
PORT=7878

# Bind address — 127.0.0.1 means nginx proxies in front of it
BIND=127.0.0.1

# T2I provider order — pollinations (free, no key) | gemini (fallback if key set)
T2I_PROVIDER=pollinations
POLLINATIONS_MODEL=flux

# Optional Gemini key — leave blank to skip
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview
