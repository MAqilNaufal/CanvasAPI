# Port the API listens on
PORT=7878

# Bind address — 127.0.0.1 means nginx proxies in front of it
BIND=127.0.0.1

# Path to the rembg-equipped python (defaults to lippo-content-automation venv)
REMBG_PYTHON=/home/ubuntu/lippo-content-automation/.venv/bin/python
REMBG_SCRIPT=/home/ubuntu/lippo-content-automation/scripts/bg_remove.py
REMBG_MODEL=u2netp

# Gemini API key — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Image gen model — gemini-2.5-flash-image-preview supports image output
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview
